// =============================================================
//  Grade Management — Database Schema (PostgreSQL)
//  วางไฟล์นี้ที่ https://dbdiagram.io/d เพื่อดู diagram
//  ที่มา: fastapi/app/models/*.py
//
//  หมายเหตุ
//  - "app default" = ค่า default ที่ SQLAlchemy ใส่ฝั่ง Python
//    ไม่ใช่ DEFAULT ใน database
//  - cascade ใน ORM ไม่ได้แปลว่า FK มี ON DELETE CASCADE
// =============================================================

Project grade_management {
  database_type: 'PostgreSQL'
  Note: '''
  ระบบจัดการคะแนน 9 ตาราง แบ่งเป็น 4 กลุ่ม
  - Auth: บัญชีผู้ใช้และวิธีล็อกอิน
  - People: นักศึกษา / อาจารย์
  - Course: รายวิชาและการลงทะเบียน
  - Grading: ควิซ คะแนน และไฟล์อัปโหลด
  '''
}


// ---------------------------------------------------------------
//  AUTH
// ---------------------------------------------------------------

Table auth_users [headercolor: #3d5a80] {
  auth_user_id  varchar       [pk, default: `gen_random_uuid()`]
  email         varchar(100)  [not null, unique]
  password      varchar(255)  [note: 'null ได้ ถ้าล็อกอินผ่าน Google']

  Note: 'บัญชีล็อกอิน 1 บัญชี = นักศึกษา 1 คน หรือ อาจารย์ 1 คน'
}

Table auth_providers [headercolor: #3d5a80] {
  provider_id       varchar       [pk, default: `gen_random_uuid()`]
  auth_user_id      varchar       [ref: > auth_users.auth_user_id]
  provider          varchar(50)   [note: 'เช่น google / password']
  provider_user_id  varchar(255)  [note: 'id จาก provider เช่น Google user id']

  Note: 'วิธีล็อกอินของแต่ละบัญชี'
}


// ---------------------------------------------------------------
//  PEOPLE
// ---------------------------------------------------------------

Table students [headercolor: #2a9d8f] {
  student_id    varchar       [pk, note: 'รหัสนักศึกษา']
  first_name    varchar(255)
  middle_name   varchar(255)
  last_name     varchar(255)
  avatar_url    varchar(500)
  auth_user_id  varchar       [ref: > auth_users.auth_user_id, note: 'ORM ใช้แบบ 1:1 แต่ DB ไม่ได้บังคับ unique']
  created_at    timestamp     [note: 'app default: utcnow']
}

Table teachers [headercolor: #2a9d8f] {
  teacher_id    varchar       [pk, default: `gen_random_uuid()`]
  first_name    varchar(255)
  middle_name   varchar(255)
  last_name     varchar(255)
  avatar_url    varchar(500)
  auth_user_id  varchar       [ref: > auth_users.auth_user_id, note: 'ORM ใช้แบบ 1:1 แต่ DB ไม่ได้บังคับ unique']
  created_at    timestamp     [note: 'app default: utcnow']
}


// ---------------------------------------------------------------
//  COURSE
// ---------------------------------------------------------------

Table courses [headercolor: #e9c46a] {
  course_code  integer       [pk, increment, note: 'PK ภายใน (ไม่ใช่รหัสวิชาที่แสดง)']
  course_id    varchar       [note: 'รหัสวิชาที่แสดง เช่น CS212']
  course_name  varchar(255)
  section      varchar(50)   [note: 'section เริ่มต้น ใช้เมื่อ enrollments.section ว่าง']
  join_code    varchar(8)    [unique, note: 'รหัสให้นักศึกษา join เอง']
  join_open    boolean       [not null, default: true]
  teacher_id   varchar       [not null, ref: > teachers.teacher_id]
  is_archive   boolean       [note: 'app default: false']
  is_deleted   boolean       [note: 'app default: false']
  created_at   timestamp     [note: 'app default: utcnow']
}

Table enrollments [headercolor: #e9c46a] {
  enrollment_id  varchar      [pk, default: `gen_random_uuid()`]
  student_id     varchar      [not null, ref: > students.student_id]
  course_code    integer      [not null, ref: > courses.course_code]
  section        varchar(50)  [note: 'section ของนักศึกษาในวิชานี้']
  status         varchar(20)  [not null, default: 'active', note: 'active | dropped']
  joined_via     varchar(20)  [not null, default: 'code', note: 'code = join เอง | csv = อาจารย์อัปโหลด']
  created_at     timestamptz  [default: `now()`]

  indexes {
    (student_id, course_code) [unique, name: 'unique_student_course']
  }

  checks {
    `status IN ('active', 'dropped')`  [name: 'enrollment_status_check']
    `joined_via IN ('code', 'csv')`    [name: 'enrollment_joined_via_check']
  }

  Note: 'นักศึกษาคนไหนอยู่วิชาไหน (many-to-many ระหว่าง students กับ courses)'
}


// ---------------------------------------------------------------
//  GRADING
// ---------------------------------------------------------------

Table quizzes [headercolor: #e76f51] {
  quiz_id      varchar       [pk, default: `gen_random_uuid()`]
  course_code  integer       [ref: > courses.course_code]
  quiz_name    varchar(255)
  full_mark    integer       [note: 'คะแนนเต็ม — app default: 100']
  weight       float         [note: 'น้ำหนักคะแนน — app default: 1.0']
  is_publish   boolean       [note: 'app default: false']
  is_deleted   boolean       [note: 'app default: false']
  created_at   timestamp     [note: 'app default: utcnow']
}

Table scores [headercolor: #e76f51] {
  score_id     varchar      [pk, default: `gen_random_uuid()`]
  quiz_id      varchar      [ref: > quizzes.quiz_id]
  student_id   varchar      [ref: > students.student_id]
  score        float        [note: 'app default: 0.0']
  unread_flag  boolean      [note: 'นักศึกษายังไม่เปิดดู — app default: true']
  is_deleted   boolean      [note: 'app default: false']
  created_at   timestamptz  [default: `now()`]
  updated_at   timestamptz  [default: `now()`, note: 'อัปเดตผ่าน SQLAlchemy onupdate (ไม่มี trigger ใน DB)']

  indexes {
    (student_id, quiz_id) [unique, name: 'unique_student_quiz']
  }

  Note: 'คะแนนของนักศึกษา 1 คนในควิซ 1 อัน'
}

Table uploads [headercolor: #e76f51] {
  upload_id    varchar       [pk, default: `gen_random_uuid()`]
  file_name    varchar(255)  [not null]
  teacher_id   varchar       [ref: > teachers.teacher_id]
  course_code  integer       [ref: > courses.course_code]
  created_at   timestamp     [note: 'app default: utcnow']

  Note: 'ประวัติไฟล์ CSV ที่อาจารย์อัปโหลด'
}


// ---------------------------------------------------------------
//  GROUPS (กรอบสีใน diagram)
// ---------------------------------------------------------------

TableGroup Auth {
  auth_users
  auth_providers
}

TableGroup People {
  students
  teachers
}

TableGroup Course {
  courses
  enrollments
}

TableGroup Grading {
  quizzes
  scores
  uploads
}
